# Redmine connection
REDMINE_URL=https://redmine.miempresa.com
REDMINE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Poner a true si Redmine usa certificado autofirmado o de CA privada
REDMINE_TLS_INSECURE=false

# Git configuration
GIT_DEFAULT_BRANCH=develop
GIT_REPO_PATH=C:\Code\MiProyecto

# Output directory for generated reports (optional, default: ./reports)
REPORT_OUTPUT_DIR=./reports
